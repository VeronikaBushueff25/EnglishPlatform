POSTGRES_PASSWORD=change-me
WEB_PORT=8080
# Ключ подписи JWT, не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SIGNING_KEY=
PUBLIC_URL=http://localhost:8080
# Первый администратор создаётся при старте, если указан
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Соединений с базой на один экземпляр API (Postgres по умолчанию принимает 100 на всех)
DB_POOL_SIZE=30
# Сколько прокси перед API: 1 — только nginx из compose; 2 — ещё Caddy с HTTPS перед ним
FORWARD_LIMIT=1
# Мониторинг: с профилем monitoring — http://dashboard:18889; пусто — экспорт выключен
OTEL_EXPORTER_OTLP_ENDPOINT=
